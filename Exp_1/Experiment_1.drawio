        </mxCell>
        <mxCell id="9JBktn6WFv3yPtU2CTlx-2" parent="1" style="text;whiteSpace=wrap;fontSize=14;" value="ASSUMPTIONS:&#xa;Daily Users = 1 Million&#xa;Request / Second = 1000000/86400 = 12&#xa;&#xa;Redirection Requests in a Day = 100 Million&#xa;Redirection Requests per sec = 100M/86400 = 1200 Requests per sec&#xa;At peak there can be more than 2 times the requests, so&#xa;Redirection Requests per sec(At peak) = 2500&#xa;&#xa;STORAGE:&#xa;Duration = 10 yrs&#xa;&#xa;Original URL = 500 Bytes&#xa;Short Code = 7 Byte&#xa;Meta Data = 93 Byte&#xa;Total Size per record = 600 Bytes" vertex="1">
          <mxGeometry height="355.5" width="590" x="710" y="252" as="geometry" />
        </mxCell>
        <mxCell id="9JBktn6WFv3yPtU2CTlx-4" parent="1" style="text;whiteSpace=wrap;fontSize=14;" value="Daily Storage = 10,00,000 x 600 = 600 MB/Day&#xa;Yearly Storage = 600 MB x 365 = 219 GB/Year&#xa;10 Year Storage = 2.2 TB" vertex="1">
          <mxGeometry height="60" width="300" x="710" y="545" as="geometry" />
        </mxCell>
        <mxCell id="9JBktn6WFv3yPtU2CTlx-5" parent="1" style="text;whiteSpace=wrap;fontSize=14;" value="CACHE REQUIRED:&#xa;According to Pareto Principle: 20% Hot URLs create 80% traffic&#xa;Daily cache = 20% of 100M = 20 Million/Day&#xa;&#xa;Memory = 20M x 600 Bytes = 12 GB&#xa;&#xa;Required RAM = 12 - 16 GB&#xa;&#xa;SERVERS REQUIRED:&#xa;Assumption - Single server can handle 2500 RPS(Request Per Second)&#xa;&#xa;According to our computations, we will require 2-3 servers with load balancers to efficiently handle all the requests." vertex="1">
          <mxGeometry height="260" width="470" x="710" y="620" as="geometry" />
        </mxCell>
